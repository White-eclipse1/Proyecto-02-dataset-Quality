# ── Database (MariaDB) — same instance the Proyecto 1 backend uses
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=image_repo

# ── Object storage — MinIO locally, AWS S3 in prod.
# Same client code talks to both; only these values change between environments.
# Leave OBJECT_STORE_ENDPOINT_URL empty to use real AWS S3.
OBJECT_STORE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_BUCKET=dataset-quality
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_USE_SSL=false

# ── Quality gate
QUALITY_GATE_CONFIG_PATH=quality.yaml

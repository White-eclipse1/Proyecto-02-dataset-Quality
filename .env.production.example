# ── App - Production
NODE_ENV=production
PORT=3100

# ── Database (MariaDB)
DATABASE_URL=mysql://user:password@db-host:3306/image_repo

DB_HOST=db-host
DB_PORT=3306
DB_USER=user
DB_PASSWORD=password
DB_NAME=image_repo

# ── Object Storage (MinIO)
MINIO_ENDPOINT=minio-host
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio-access-key
MINIO_SECRET_KEY=minio-secret-key
MINIO_BUCKET=image-annotations

# Tamaño máximo permitido por imagen: 5 MB.
MAX_UPLOAD_SIZE_BYTES=5242880

# ── Data Quality pipeline (SPEC-PIPE-001, APP-07)
# En despliegue real, montar pipeline/data/interim/ (la salida real de
# `dvc repro`, no contracts/) y quality.yaml donde la pipeline los escribe,
# y apuntar estas rutas ahí.
PIPELINE_OUTPUT_DIR=/data/pipeline-output
QUALITY_POLICY_PATH=/data/quality.yaml